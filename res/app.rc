#include <windows.h>
#include <winver.h>
#include "options.h"

1 ICON "app.ico"
1 24 "app.manifest"

IDD_OPTIONS DIALOGEX 0, 0, 254, 215
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Wireless Battery Options"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "BATTERY DISPLAY", IDC_OPTIONS_TITLE, 14, 14, 226, 15
  AUTORADIOBUTTON "&Taskbar", IDC_MODE_TASKBAR, 14, 38, 63, 14, WS_GROUP | WS_TABSTOP
  AUTORADIOBUTTON "&Desktop widget", IDC_MODE_DESKTOP, 83, 38, 81, 14
  AUTORADIOBUTTON "Tray &icons", IDC_MODE_TRAY, 174, 38, 65, 14
  AUTOCHECKBOX "&Hide sleeping devices", IDC_HIDE_ASLEEP, 14, 59, 226, 14, WS_GROUP | WS_TABSTOP

  LTEXT "BATTERY MONITORING", IDC_OPTIONS_MONITORING, 14, 90, 226, 13
  LTEXT "&Refresh interval", -1, 14, 110, 116, 13
  COMBOBOX IDC_POLL_INTERVAL, 144, 108, 96, 94, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP
  LTEXT "&Low-battery threshold", -1, 14, 131, 116, 13
  COMBOBOX IDC_LOW_BATTERY, 144, 129, 96, 106, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP
  AUTOCHECKBOX "Show low-battery &alerts in tray mode", IDC_TRAY_ALERTS, 14, 151, 226, 14, WS_TABSTOP

  AUTOCHECKBOX "Start with &Windows", IDC_START_WITH_WINDOWS, 14, 190, 110, 14, WS_TABSTOP
  PUSHBUTTON "Cancel", IDCANCEL, 134, 187, 49, 19
  DEFPUSHBUTTON "Save", IDOK, 191, 187, 49, 19
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Wireless Battery"
      VALUE "ProductName", "Wireless Battery"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "WirelessBattery.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
